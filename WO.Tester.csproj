<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
 <PropertyGroup>
  <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
  <OutputType>WinExe</OutputType><AssemblyName>WO Tester</AssemblyName><RootNamespace>WOTester</RootNamespace>
  <TargetFrameworkVersion>v4.8</TargetFrameworkVersion><StartupObject>WOTester.Program</StartupObject>
  <OutputPath>bin\$(Configuration)\</OutputPath><Optimize>true</Optimize><DebugType>pdbonly</DebugType>
  <ApplicationManifest>assets\app.manifest</ApplicationManifest><ApplicationIcon>assets\wo-tester.ico</ApplicationIcon>
 </PropertyGroup>
 <ItemGroup>
  <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Web"/><Reference Include="System.Web.Extensions"/>
  <Reference Include="System.Xaml"/><Reference Include="WindowsBase"/><Reference Include="PresentationCore"/><Reference Include="PresentationFramework"/>
  <Compile Include="src\*.cs"/>
  <EmbeddedResource Include="src\MainWindow.xaml"><LogicalName>WOTester.MainWindow.xaml</LogicalName></EmbeddedResource>
  <EmbeddedResource Include="assets\probe.gd"><LogicalName>WOTester.probe.gd</LogicalName></EmbeddedResource>
 </ItemGroup>
 <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
</Project>
