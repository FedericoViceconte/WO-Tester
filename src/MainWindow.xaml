<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WO Tester" Width="1320" Height="900" MinWidth="1080" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#0D111A" Foreground="#EEF3FF" FontFamily="Segoe UI" FontSize="13" WindowStyle="None" ResizeMode="CanResize">
<Window.Resources>
<SolidColorBrush x:Key="Muted" Color="#8F9CB3"/>
<Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#202D43"/><Setter Property="Foreground" Value="#E8EEFC"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="17,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value=".78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#B5CAFF"/><Setter TargetName="B" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="15,13"/></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#0D1420"/><Setter Property="Foreground" Value="#EAF0FF"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#2B3952"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><Grid><ScrollViewer x:Name="PART_ContentHost"/><TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="#7087AA" IsHitTestVisible="False" Visibility="Collapsed"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Foreground" Value="#EAF0FF"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#172238" BorderBrush="#33435D" BorderThickness="1" CornerRadius="7"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#A4B4CF"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,0,32,0" VerticalAlignment="Center"/><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#172238" BorderBrush="#33435D" BorderThickness="1" CornerRadius="7" MinWidth="{TemplateBinding ActualWidth}"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EAF0FF"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="B" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="B" Property="Background" Value="#2C4163"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C2CCE0"/><Setter Property="Margin" Value="0,10"/></Style>
<Style TargetType="DataGrid"><Setter Property="Background" Value="#121B29"/><Setter Property="Foreground" Value="#DEE7F9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="#121B29"/><Setter Property="AlternatingRowBackground" Value="#151F2F"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="39"/><Setter Property="ColumnHeaderHeight" Value="36"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/></Style>
<Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#192437"/><Setter Property="Foreground" Value="#8FA2C1"/><Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="11"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#263B5B"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
</Window.Resources>
<Border Background="#0D111A" BorderBrush="#263146" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid x:Name="TitleBar" Background="#0A0F17"><TextBlock Text="WO TESTER    /    QUALITY LAB" FontSize="10" Foreground="#8B9BB5" VerticalAlignment="Center" Margin="19,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="MinButton" Content="—" Width="44" Padding="0" Background="Transparent"/><Button x:Name="MaxButton" Content="□" Width="44" Padding="0" Background="Transparent"/><Button x:Name="CloseButton" Content="✕" Width="44" Padding="0" Background="Transparent"/></StackPanel></Grid>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#111925" BorderBrush="#223047" BorderThickness="0,0,1,0"><Grid Margin="16,28,16,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="10,0,0,30"><Border Background="#203A60" CornerRadius="13" Width="48" Height="48" HorizontalAlignment="Left"><Path Data="M 9,17 L 15,30 L 23,11 M 23,11 L 30,30 L 37,17" Stroke="#8FB9FF" StrokeThickness="3"/></Border><TextBlock Text="WO Tester" FontSize="24" FontWeight="SemiBold" Margin="0,14,0,3"/><TextBlock Text="Tu laboratorio de pruebas" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
<StackPanel Grid.Row="1"><TextBlock Text="ESPACIO DE TRABAJO" FontSize="9" Foreground="#6B82A6" Margin="14,0,0,10"/><Button x:Name="NavDashboard" Style="{StaticResource Nav}" Content="◈    Panel de pruebas" Background="#233858"/><Button x:Name="NavHistory" Style="{StaticResource Nav}" Content="◷    Historial"/><Button x:Name="NavSettings" Style="{StaticResource Nav}" Content="⚙    Configuración"/><Button x:Name="NavAbout" Style="{StaticResource Nav}" Content="ⓘ    Acerca de"/></StackPanel>
<StackPanel Grid.Row="3"><Border CornerRadius="10" Padding="13" Background="#172437"><StackPanel><TextBlock Text="●  PERFILES AISLADOS" FontSize="10" Foreground="#6AD8B6"/><TextBlock Text="Cada escenario usa datos propios de prueba." Foreground="#91A3BF" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border><TextBlock Text="FRR GAMES  ·  v1.0.0" FontSize="10" Foreground="#7184A3" Margin="12,17,0,0"/></StackPanel>
</Grid></Border>
<Grid Grid.Column="1" Margin="30,24,30,20">
<Grid x:Name="Dashboard"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="126"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="CONTROL DE CALIDAD" FontSize="10" Foreground="#7C9BCC"/><TextBlock Text="Probá. Encontrá. Mejorá." FontSize="29" FontWeight="SemiBold" Margin="0,5,0,5"/><TextBlock Text="Una revisión reproducible de WO Definitive, de principio a fin." Foreground="{StaticResource Muted}"/></StackPanel><Button x:Name="ReportButton" Content="↗  Abrir informe" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="False"/></Grid>
<Border Grid.Row="1" Background="#151F2F" BorderBrush="#293A55" BorderThickness="1" CornerRadius="13" Padding="18,15" Margin="0,19,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="WO DEFINITIVE" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="GameVersion" Text="SIN CONECTAR" Foreground="#90B6FF" FontSize="11" Margin="14,0,0,0"/></StackPanel><TextBlock x:Name="ProjectCaption" Text="Elegí el proyecto del juego para comenzar." Foreground="#899BB8" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock x:Name="InventoryCaption" Text="Mapas, armas y escenarios se detectan automáticamente." Foreground="#B8C8E3" FontSize="11" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" x:Name="ProjectButton" Content="Cambiar proyecto" VerticalAlignment="Center" Margin="20,0,0,0"/></Grid></Border>
<Grid Grid.Row="2" Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="118"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ModeBox" AutomationProperties.Name="Tipo de revisión"><ComboBoxItem Content="Revisión completa" Tag="complete"/><ComboBoxItem Content="Revisión rápida" Tag="quick"/><ComboBoxItem Content="Repetir fallos anteriores" Tag="failed"/></ComboBox><ComboBox Grid.Column="1" x:Name="SpeedBox" Margin="10,0,0,0" AutomationProperties.Name="Velocidad"><ComboBoxItem Content="1×" Tag="1"/><ComboBoxItem Content="2×" Tag="2"/><ComboBoxItem Content="5×" Tag="5"/><ComboBoxItem Content="10×" Tag="10"/></ComboBox><Button Grid.Column="2" x:Name="StartButton" Content="▶  Iniciar revisión" Background="#729BFF" Foreground="#0A1530" FontWeight="SemiBold" Margin="13,0,0,0" Padding="24,11"/><Button Grid.Column="3" x:Name="StopButton" Content="Detener" Margin="9,0,0,0" IsEnabled="False"/></Grid>
<Border Grid.Row="3" Background="#121B29" CornerRadius="10" Padding="15,12" Margin="0,0,0,13"><StackPanel><Grid><TextBlock x:Name="ProgressCaption" Text="Todo listo para la primera revisión." Foreground="#B8C9E7" FontSize="12"/><TextBlock x:Name="ElapsedCaption" Text="00:00" HorizontalAlignment="Right" Foreground="#8098BE"/></Grid><ProgressBar x:Name="RunProgress" Height="4" Margin="0,10,0,0" Background="#26354B" Foreground="#7C9FFF" BorderThickness="0" Maximum="100"/></StackPanel></Border>
<UniformGrid Grid.Row="4" Columns="4" Margin="0,0,-10,14"><Border Background="#152B29" CornerRadius="10" Padding="17,11" Margin="0,0,10,0"><StackPanel><TextBlock x:Name="PassedCount" Text="0" FontSize="27" FontWeight="SemiBold" Foreground="#6BDDB8"/><TextBlock Text="CORRECTAS" FontSize="9" Foreground="#8EB9AC"/></StackPanel></Border><Border Background="#2B1D2A" CornerRadius="10" Padding="17,11" Margin="0,0,10,0"><StackPanel><TextBlock x:Name="FailedCount" Text="0" FontSize="27" FontWeight="SemiBold" Foreground="#FF8994"/><TextBlock Text="ERRORES" FontSize="9" Foreground="#C89DA7"/></StackPanel></Border><Border Background="#29251D" CornerRadius="10" Padding="17,11" Margin="0,0,10,0"><StackPanel><TextBlock x:Name="PendingCount" Text="0" FontSize="27" FontWeight="SemiBold" Foreground="#F2CE85"/><TextBlock Text="PENDIENTES / REVISAR" FontSize="9" Foreground="#BAAE91"/></StackPanel></Border><Border Background="#1C2538" CornerRadius="10" Padding="17,11" Margin="0,0,10,0"><StackPanel><TextBlock x:Name="ChecksCount" Text="0" FontSize="27" FontWeight="SemiBold" Foreground="#9CB9FF"/><TextBlock Text="COMPROBACIONES" FontSize="9" Foreground="#8C9FBE"/></StackPanel></Border></UniformGrid>
<Grid Grid.Row="5"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="164"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Tag="Buscar mapa, arma o error..." ToolTip="Buscar por nombre, categoría o detalle" AutomationProperties.Name="Buscar resultados" MinHeight="34" Padding="11,6"/><ComboBox Grid.Column="1" x:Name="FilterBox" Margin="10,0,0,0" MinHeight="34"><ComboBoxItem Content="Todos los estados" Tag="all"/><ComboBoxItem Content="Errores" Tag="FAIL"/><ComboBoxItem Content="Correctas" Tag="PASS"/><ComboBoxItem Content="Pendientes" Tag="pending"/></ComboBox></Grid>
<Border Grid.Row="1" CornerRadius="10" Background="#121B29" ClipToBounds="True"><Grid><DataGrid x:Name="ResultsGrid"><DataGrid.Columns><DataGridTemplateColumn Header="ESTADO" Width="114"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="{Binding Color}" FontSize="10" FontWeight="SemiBold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="ESCENARIO" Binding="{Binding Name}" Width="*" MinWidth="300"/><DataGridTextColumn Header="ÁREA" Binding="{Binding Category}" Width="144"/><DataGridTextColumn Header="TIEMPO" Binding="{Binding Duration}" Width="77"/></DataGrid.Columns></DataGrid><StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="◈" FontSize="30" Foreground="#486797" HorizontalAlignment="Center"/><TextBlock Text="Acá vas a ver los resultados" FontSize="16" Foreground="#A9BBD7" Margin="0,10,0,5"/><TextBlock Text="Cada error conserva su registro y los pasos para repetirlo." Foreground="#7C94B5" FontSize="11"/></StackPanel></Grid></Border></Grid>
<Border Grid.Row="6" Background="#111925" BorderBrush="#25334B" BorderThickness="1" CornerRadius="10" Padding="15,12" Margin="0,12,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock x:Name="DetailTitle" Text="DETALLE DEL ESCENARIO" FontSize="10" Foreground="#8EA5C9"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CopyButton" Content="Copiar" FontSize="10" Padding="10,3" Margin="0,0,7,0"/><Button x:Name="LogButton" Content="Ver registro" FontSize="10" Padding="10,3"/></StackPanel></Grid><TextBox Grid.Row="1" x:Name="DetailText" Text="Seleccioná un resultado para ver qué ocurrió y qué conviene revisar." IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0,8,0,0" FontSize="11" Foreground="#A7B9D5"/></Grid></Border>
</Grid>
<Grid x:Name="HistoryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="HISTORIAL LOCAL" FontSize="10" Foreground="#7C9BCC"/><TextBlock Text="Cada revisión cuenta." FontSize="30" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="Compará versiones y recuperá los informes de tus últimas ejecuciones." Foreground="{StaticResource Muted}"/></StackPanel><Button Grid.Row="1" x:Name="RefreshHistory" Content="Actualizar historial" HorizontalAlignment="Left" Margin="0,22,0,16"/><DataGrid Grid.Row="2" x:Name="HistoryGrid"><DataGrid.Columns><DataGridTextColumn Header="EJECUCIÓN" Binding="{Binding Id}" Width="*" MinWidth="240"/><DataGridTextColumn Header="VERSIÓN" Binding="{Binding GameVersion}" Width="85"/><DataGridTextColumn Header="MODO" Binding="{Binding Mode}" Width="90"/><DataGridTextColumn Header="ERRORES" Binding="{Binding Failed}" Width="85"/><DataGridTextColumn Header="ESTADO" Binding="{Binding State}" Width="130"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="OpenHistoryReport" Content="Abrir informe seleccionado"/><Button x:Name="LoadHistoryReport" Content="Ver resultados en el panel" Margin="10,0,0,0"/><Button x:Name="OpenRuns" Content="Abrir carpeta" Margin="10,0,0,0"/></StackPanel></Grid>
<ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="780" HorizontalAlignment="Left"><TextBlock Text="CONFIGURACIÓN" FontSize="10" Foreground="#7C9BCC"/><TextBlock Text="Tu entorno de pruebas." FontSize="30" FontWeight="SemiBold" Margin="0,8,0,24"/><TextBlock Text="Proyecto editable de WO Definitive" Margin="0,0,0,8"/><DockPanel><Button x:Name="BrowseProject" Content="Elegir" DockPanel.Dock="Right" Margin="9,0,0,0"/><TextBox x:Name="ProjectPath" MinWidth="520"/></DockPanel><TextBlock Text="Seleccioná VERSION-ACTUAL o project.godot. El tester se mantiene fuera del juego." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,22"/><TextBlock Text="Godot 4 · ejecutable de consola" Margin="0,0,0,8"/><DockPanel><Button x:Name="BrowseGodot" Content="Elegir" DockPanel.Dock="Right" Margin="9,0,0,0"/><TextBox x:Name="GodotPath" MinWidth="520"/></DockPanel><TextBlock Text="Usá la misma versión del motor que indica el proyecto." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,22"/><StackPanel Orientation="Horizontal"><StackPanel Width="260"><TextBlock Text="Tiempo máximo por prueba (segundos)" Margin="0,0,0,8"/><TextBox x:Name="TimeoutBox" Width="210" HorizontalAlignment="Left"/></StackPanel><StackPanel Width="230"><TextBlock Text="Semilla reproducible" Margin="0,0,0,8"/><TextBox x:Name="SeedBox" Width="210" HorizontalAlignment="Left"/></StackPanel></StackPanel><CheckBox x:Name="AutoRunBox" Content="Iniciar una revisión automáticamente al abrir WO Tester" Margin="0,22,0,5"/><CheckBox x:Name="VisibleBox" Content="Mostrar los mapas y guardar capturas a velocidad normal"/><Border Background="#172437" CornerRadius="10" Padding="18" Margin="0,22,0,20"><TextBlock Text="La aceleración se aplica a los escenarios del adaptador con pasos de simulación originales. Las pruebas nativas corren a 1×. Online real, EAC, audio y rendimiento en otros equipos requieren validación específica." Foreground="#A8BDDD" LineHeight="21"/></Border><Button x:Name="SaveSettings" Content="Guardar configuración" Background="#729BFF" Foreground="#0A1530" HorizontalAlignment="Left"/><TextBlock x:Name="SettingsFeedback" Foreground="#6BDDB8" Margin="0,15,0,0"/></StackPanel></ScrollViewer>
<StackPanel x:Name="AboutPage" Visibility="Collapsed" MaxWidth="750" HorizontalAlignment="Left"><TextBlock Text="WO TESTER" FontSize="11" Foreground="#8FB4FF"/><TextBlock Text="Un laboratorio para tu juego." FontSize="34" FontWeight="SemiBold" Margin="0,10,0,20"/><TextBlock Text="Versión 1.0.0 · Aplicación independiente para Windows" Foreground="#B2C7E8" FontSize="16"/><TextBlock Text="Descubre datos y escenas de prueba de WO Definitive. Ejecuta comprobaciones repetibles, conserva evidencia y muestra la cobertura pendiente." Foreground="{StaticResource Muted}" LineHeight="23" Margin="0,20,0,20"/><Border Background="#172437" CornerRadius="13" Padding="24"><StackPanel><TextBlock Text="Qué significa un resultado" FontSize="18" Margin="0,0,0,12"/><TextBlock Text="CORRECTO · Se cumplieron las comprobaciones del escenario.&#x0a;ERROR · Una comprobación falló o el motor registró un error.&#x0a;BLOQUEADA · Faltó un requisito o se agotó el tiempo.&#x0a;REVISAR · La evidencia necesita interpretación o cobertura adicional." Foreground="#AFBED6" LineHeight="26"/></StackPanel></Border><TextBlock Text="Una revisión aprobada no garantiza que el juego esté libre de bugs. El tester no corrige archivos automáticamente ni certifica servicios online a partir de simulaciones locales." Foreground="{StaticResource Muted}" Margin="0,22,0,20" LineHeight="23"/><StackPanel Orientation="Horizontal"><Button x:Name="GithubButton" Content="↗  Repositorio en GitHub"/><Button x:Name="DocsButton" Content="Guía de uso" Margin="10,0,0,0"/></StackPanel><TextBlock Text="FRR Games · Hecho para acompañar cada versión de WO Definitive." Foreground="#7189AC" Margin="0,35,0,0"/></StackPanel>
</Grid></Grid></Grid></Border></Window>